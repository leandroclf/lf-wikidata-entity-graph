{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "lf-wikidata-entity-graph",
    "description": "Coleção completa para a API de resolução de entidades com vinculação ao Wikidata.\n\nO serviço utiliza similaridade Jaccard por tokens de palavras para comparar nomes de entidades e vinculá-las ao grafo de conhecimento do Wikidata.\n\n**URL de produção:** https://lf-wikidata-entity-graph.onrender.com\n\nImporte também o environment `postman_environment.json` para configurar `{{base_url}}` e `{{base_url_local}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://lf-wikidata-entity-graph.onrender.com",
      "type": "string",
      "description": "URL base de produção"
    }
  ],
  "item": [
